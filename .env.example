APP_NAME="Вольт"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://05-online-shop.local

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.1.28
DB_PORT=3306
DB_DATABASE=online_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Магазин
SHOP_PHONE="+7 (800) 555-35-35"
SHOP_EMAIL=shop@example.com
# Сколько минут держать резерв товара за неоплаченным заказом
SHOP_PAYMENT_TTL=60
# Доставка курьером, копейки: цена и порог бесплатной доставки
SHOP_COURIER_PRICE=49000
SHOP_FREE_DELIVERY_FROM=5000000
# На виртуальном хостинге нет постоянных процессов: очередь разбирает cron
SHOP_SCHEDULED_QUEUE_WORKER=false
# Демо-режим: форма входа в админку заполнена демо-доступом
SHOP_DEMO=true
SHOP_DEMO_EMAIL=admin@example.com
SHOP_DEMO_PASSWORD=password

# Демо-оплата вместо ЮKassa (страница «Тестовая оплата» в самом магазине, деньги не списываются).
# Для демо-стенда, пока магазин не подключён к ЮKassa.
YOOKASSA_DEMO=false

# ЮKassa: ключи тестового магазина — в личном кабинете ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ (нужен, если в магазине подключена онлайн-касса)
YOOKASSA_RECEIPT=false
YOOKASSA_VAT_CODE=1
# Принимать уведомления только с IP ЮKassa. За прокси (Cloudflare Worker) выключить:
# статус платежа всё равно перепроверяется запросом к API.
YOOKASSA_VERIFY_IP=true

VITE_APP_NAME="${APP_NAME}"
